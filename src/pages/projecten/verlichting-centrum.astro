---
import Layout from "../../layouts/Layout.astro";
import ContactCta from "../../components/ContactCta.astro";
import { MapPin, Calendar, Clock, CheckCircle, ArrowLeft } from "lucide-react";
import { Image } from "astro:assets";
import heroImage from "../../assets/images/electrical-measurement-tools.webp";
---

<Layout title="Lichtplan Woonkeuken Culemborg | Van der Veen Elektrotechniek">
    <section class="bg-surface-dark pt-32 pb-8">
        <div class="container-custom">
            <a
                href="/projecten/"
                class="inline-flex items-center text-slate-500 hover:text-primary mb-6 transition-colors"
            >
                <ArrowLeft className="w-4 h-4 mr-2" />
                Terug naar projecten
            </a>
            <div class="flex items-center gap-3 mb-4">
                <div
                    class="bg-accent/90 backdrop-blur-md px-4 py-1.5 rounded-full text-xs font-bold text-white uppercase tracking-wider"
                >
                    Verlichting
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <MapPin className="w-4 h-4" />
                    <span>Culemborg, Centrum</span>
                </div>
            </div>
            <h1
                class="text-4xl md:text-5xl font-bold font-heading text-primary mb-6"
            >
                Lichtplan Woonkeuken
            </h1>
            <p class="text-lg text-slate-600 max-w-3xl">
                Frezen van nieuwe leidingen en installatie van dimbare LED-spots
                en pendelarmaturen boven het kookeiland.
            </p>
        </div>
    </section>

    <section class="py-12 bg-surface border-b border-border">
        <div class="container-custom">
            <div class="aspect-[21/9] rounded-2xl overflow-hidden shadow-xl">
                <Image
                    src={heroImage}
                    alt="LED verlichting installatie woonkeuken Culemborg"
                    width={1200}
                    height={514}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </section>

    <section class="py-16 bg-surface">
        <div class="container-custom">
            <div class="grid lg:grid-cols-3 gap-12">
                <div class="lg:col-span-2 space-y-8">
                    <div>
                        <h2
                            class="text-2xl font-bold font-heading text-primary mb-4"
                        >
                            De situatie
                        </h2>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Dit karakteristieke pand in het centrum van
                            Culemborg kreeg een compleet nieuwe woonkeuken. De
                            bewoners wilden een modern lichtplan dat zowel
                            functioneel als sfeervol zou zijn.
                        </p>
                        <p class="text-slate-600 leading-relaxed">
                            De uitdaging: er was geen bestaande bekabeling voor
                            spots en de bewoners wilden alle verlichting dimbaar
                            hebben voor verschillende sferen.
                        </p>
                    </div>

                    <div>
                        <h2
                            class="text-2xl font-bold font-heading text-primary mb-4"
                        >
                            Onze oplossing
                        </h2>
                        <p class="text-slate-600 leading-relaxed mb-6">
                            We hebben een compleet lichtplan ontworpen met drie
                            zones: werkverlichting boven het aanrecht, sfeervolle
                            pendels boven het kookeiland en algemene verlichting
                            via inbouwspots.
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <CheckCircle
                                    className="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                                />
                                <span class="text-slate-600"
                                    >8 dimbare LED inbouwspots (IP44)</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <CheckCircle
                                    className="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                                />
                                <span class="text-slate-600"
                                    >3 design pendelarmaturen boven kookeiland</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <CheckCircle
                                    className="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                                />
                                <span class="text-slate-600"
                                    >LED-strip onder bovenkastjes</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <CheckCircle
                                    className="w-5 h-5 text-accent mt-0.5 flex-shrink-0"
                                />
                                <span class="text-slate-600"
                                    >Alle groepen op Casambi draadloze dimmer</span
                                >
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h2
                            class="text-2xl font-bold font-heading text-primary mb-4"
                        >
                            Het resultaat
                        </h2>
                        <p class="text-slate-600 leading-relaxed">
                            De keuken is getransformeerd tot een multifunctionele
                            ruimte. 's Ochtends fel licht om te koken, 's avonds
                            gedimde sfeerverlichting voor het diner. Alles
                            bedienbaar via een simpele app of de wandschakelaar.
                        </p>
                    </div>
                </div>

                <div class="space-y-6">
                    <div
                        class="bg-surface-dark p-6 rounded-xl border border-border"
                    >
                        <h3 class="font-bold text-primary mb-4">
                            Projectgegevens
                        </h3>
                        <ul class="space-y-4">
                            <li class="flex items-center gap-3 text-sm">
                                <MapPin className="w-4 h-4 text-slate-400" />
                                <span class="text-slate-600"
                                    >Culemborg, Centrum</span
                                >
                            </li>
                            <li class="flex items-center gap-3 text-sm">
                                <Calendar className="w-4 h-4 text-slate-400" />
                                <span class="text-slate-600">September 2024</span
                                >
                            </li>
                            <li class="flex items-center gap-3 text-sm">
                                <Clock className="w-4 h-4 text-slate-400" />
                                <span class="text-slate-600">2 werkdagen</span>
                            </li>
                        </ul>
                    </div>

                    <div class="bg-primary text-white p-6 rounded-xl">
                        <h3 class="font-bold text-lg mb-3">
                            Ook een lichtplan nodig?
                        </h3>
                        <p class="text-white/90 text-sm mb-4">
                            Wij denken graag mee over de perfecte verlichting
                            voor uw ruimte.
                        </p>
                        <a
                            href="/contact/"
                            class="block w-full text-center bg-accent hover:bg-accent-light text-white font-bold py-3 rounded-lg transition-colors"
                            >Gratis adviesgesprek</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <ContactCta />
</Layout>
