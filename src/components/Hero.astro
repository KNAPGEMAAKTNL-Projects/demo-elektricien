---
import { Check, Star } from "lucide-react";
import { Image } from "astro:assets";
import heroImage from "../assets/images/electrician-working-electrical-box.webp";
---

<section
    class="relative bg-surface overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24"
>
    <div class="container-custom relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
            <!-- Left Column: Content -->
            <div class="max-w-2xl animate-fade-in">
                <!-- Social Proof Pill -->
                <div
                    class="inline-flex items-center gap-2 bg-white border border-border-dark rounded-full px-4 py-1.5 mb-6 shadow-sm"
                >
                    <div class="flex gap-0.5 text-rating">
                        <Star className="w-4 h-4 fill-current" />
                        <Star className="w-4 h-4 fill-current" />
                        <Star className="w-4 h-4 fill-current" />
                        <Star className="w-4 h-4 fill-current" />
                        <Star className="w-4 h-4 fill-current" />
                    </div>
                    <span class="text-xs font-semibold text-slate-600"
                        >Rated 9.8/10 door 120+ klanten</span
                    >
                </div>

                <h1
                    class="text-4xl lg:text-6xl font-bold font-heading text-primary leading-[1.1] mb-6 text-balance"
                >
                    Uw betrouwbare elektricien in <span class="text-accent"
                        >Culemborg</span
                    >.
                </h1>

                <p
                    class="text-base lg:text-lg text-slate-600 mb-8 leading-relaxed max-w-lg text-balance"
                >
                    Van groepenkast tot laadpaal. Wij leveren vakwerk zonder
                    gedoe. Eerlijke prijzen, duidelijke afspraken en altijd
                    alles netjes achtergelaten.
                </p>

                <!-- Benefits List (Micro-trust) -->
                <ul class="space-y-3 mb-10">
                    <li class="flex items-center gap-3 text-slate-700">
                        <div
                            class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center"
                        >
                            <Check className="w-4 h-4 text-accent" />
                        </div>
                        <span class="text-sm font-medium"
                            >Geen voorrijkosten in Culemborg</span
                        >
                    </li>
                    <li class="flex items-center gap-3 text-slate-700">
                        <div
                            class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center"
                        >
                            <Check className="w-4 h-4 text-accent" />
                        </div>
                        <span class="text-sm font-medium"
                            >Binnen 24 uur geholpen bij spoed</span
                        >
                    </li>
                    <li class="flex items-center gap-3 text-slate-700">
                        <div
                            class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center"
                        >
                            <Check className="w-4 h-4 text-accent" />
                        </div>
                        <span class="text-sm font-medium"
                            >Erkend Sterkin installateur</span
                        >
                    </li>
                </ul>

                <!-- Dual CTA -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/offerte/" class="btn-primary">
                        Offerte Aanvragen
                        <span class="ml-2 text-white/80 text-xs font-normal"
                            >(Gratis)</span
                        >
                    </a>
                    <a href="tel:0612345678" class="btn-secondary group">
                        <div
                            class="w-2 h-2 rounded-full bg-accent/100 mr-2 animate-pulse"
                        >
                        </div>
                        Direct storingshulp
                    </a>
                </div>
            </div>

            <!-- Right Column: Image -->
            <div
                class="relative lg:h-[600px] w-full animate-slide-up animation-delay-200"
            >
                <!-- Main Image Frame -->
                <div
                    class="relative h-full w-full rounded-2xl overflow-hidden shadow-2xl border-4 border-white"
                >
                    <Image
                        src={heroImage}
                        alt="Gecertificeerde elektricien werkt aan moderne groepenkast in Culemborg"
                        width={1920}
                        height={1280}
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        class="object-cover w-full h-full transform hover:scale-105 transition-transform duration-700"
                    />

                    <!-- Floating Badge -->
                    <div
                        class="absolute bottom-6 left-6 bg-primary/90 backdrop-blur-md shadow-2xl px-5 py-4 rounded-2xl max-w-xs"
                    >
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-green-400 animate-pulse shadow-lg shadow-green-400/50"></div>
                            <div>
                                <p class="text-sm font-bold text-white">
                                    Actief in Culemborg
                                </p>
                                <p class="text-xs text-white/70">
                                    Onze monteurs zijn nu in de buurt
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Decorative Elements behind -->
                <div
                    class="absolute -top-12 -right-12 w-64 h-64 bg-accent/10 rounded-full blur-3xl -z-10"
                >
                </div>
                <div
                    class="absolute -bottom-12 -left-12 w-64 h-64 bg-primary/5 rounded-full blur-3xl -z-10"
                >
                </div>
            </div>
        </div>
    </div>
</section>
